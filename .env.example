# ==================== VolOI 本地环境示例 ====================
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/postgres
BINANCE_REST_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com/stream
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
AUTO_START_MONITOR=true
REST_RATE_PER_SECOND=4
REST_CONCURRENCY=5
REST_TIMEOUT_SECONDS=10
REST_MAX_RETRIES=3
WS_STREAMS_PER_CONNECTION=150
KLINE_HISTORY_LIMIT=498
# 前端本地开发可选；生产环境默认使用同源 /api/ws/signals。
VITE_WS_URL=ws://localhost:8000/api/ws/signals
